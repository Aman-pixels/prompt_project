# IPDPO Environment Configuration
# Copy this file to .env and provide your actual Gemini API key if you want LLM-assisted refinement.
# Local deterministic generation, validation, scoring, versioning, and export work without an API key.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
IPDPO_DB_PATH=ipdpo.db
IPDPO_DEFAULT_EXPORT_DIR=exports
